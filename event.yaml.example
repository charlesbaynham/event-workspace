# Per-event configuration. Copy to event.yaml and fill in. Top-level scalars
# are read by the hooks (default_branch, agent_tools_upstream); everything
# else is read by the skills as prose. Nothing here is secret — no tokens.

name: "Ada & Ben's wedding"
default_branch: main
agent_tools_upstream: https://github.com/charlesbaynham/event-workspace
# How agent-tools/update.sh follows upstream: `latest` takes the tip of its
# default branch (what the author runs); `pinned` keeps the version this
# workspace is already on (agent-tools/VERSION) and never moves on its own.
# Any other value is used as a branch name.
agent_tools_track: pinned
# The SessionStart hook compares agent-tools/ with upstream's — on `pinned`
# only a newer VERSION counts, on `latest` any difference does — quotes the
# changelog entries you do not have, and offers the update. Both keys below are written by an agent when you answer one of those
# offers — leave them out until then.
# agent_tools_update_check: off            # stop offering updates entirely
# agent_tools_version_skip: 0.6.0, abc123def456   # declined: versions (pinned) or upstream commits (latest)

# Whose word is authoritative in a session. Technical register.
owners: [Ada]
# Non-technical people who also use the workspace. Warm register, no mechanics.
co_users: [Ben]

# Where the facts live. The repo's memory/ is an index of this, never a
# replacement for it.
source_of_truth: "the Master File (Google Sheet)"
sheets:
  master: <spreadsheet id>
  live_forms:                      # sources that change continuously — re-read live
    rsvps: <spreadsheet id>

whatsapp:
  bot_name: EventBot
  mcp_prefix: mcp__Event_Whatsapp__          # the bot's connector
  personal_prefixes: [mcp__Whatsapp__]       # anyone's personal account; never unattended
  identity_roster: "the Guests tab of the Master File"
  shareable: [where people are staying]      # categories the owner may approve sharing
  read_only_chats: []                        # e.g. ["Ada and Ben planning"] — §13
  gate_exempt: []                            # §14 — each entry needs provenance:
  #  - number: "447912345678"
  #    name: Ben
  #    authorised_by: Ada
  #    date: 2026-09-11
  #    where: "in a Claude Code session, recorded in memory/whatsapp/447700900123.xml"
  routine_name: "EventBot WhatsApp webhook"
